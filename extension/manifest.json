{
  "manifest_version": 3,
  "name": "Jev Voice",
  "version": "0.1.0",
  "description": "Talk to your browser. Claude plans the command, Jev carries it out in your own profile, without remote debugging.",
  "key": "",
  "permissions": ["sidePanel", "scripting", "nativeMessaging", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {"service_worker": "bg.js"},
  "action": {"default_title": "Jev Voice", "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}},
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"},
  "side_panel": {"default_path": "panel.html"},
  "commands": {
    "_execute_action": {"suggested_key": {"default": "Alt+J"}, "description": "Open Jev Voice"}
  }
}
