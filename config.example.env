# Jev Voice keys. bin/install copies this file to ~/.config/jev-voice/env (mode 600); fill it in there.
# The browser starts the host without your shell profile, so keys exported in ~/.bashrc are not seen.
# Variables already present in the host's environment win over this file.

# Jev decisions (https://typesafe.ai)
TYPESAFE_API_KEY=

# Text typed into fields: any OpenAI-compatible endpoint (jev-ultrafast's TEXT_MODEL_* variables).
# Setting OPENROUTER_API_KEY alone is enough: it defaults to OpenRouter with inception/mercury-2.5.
OPENROUTER_API_KEY=
# TEXT_MODEL_API_KEY=
# TEXT_MODEL_BASE_URL=https://api.deepseek.com/v1
# TEXT_MODEL=deepseek-chat

# Speech to text (Cloudflare Workers AI: Deepgram nova-3, optional Whisper pass). Optional: without them the panel
# works with typed commands. A token with the "Workers AI - Read" and "Workers AI - Edit" permissions
# (https://developers.cloudflare.com/workers-ai/get-started/rest-api/), and the account id shown in the dashboard.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Optional: path of the claude CLI when it is not on the browser's PATH or in ~/.local/bin.
# JEV_VOICE_CLAUDE=/usr/local/bin/claude
