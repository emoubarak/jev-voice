#!/bin/sh
# Try Jev Voice in a throwaway Chromium profile, without touching your own browser.
#   bin/try [extra Chromium flags]       CHROME=/path/to/chromium bin/try   to pick the binary
# Branded Google Chrome ignores --load-extension: use Chromium or Chrome for Testing here.
set -e
ROOT=$(cd "$(dirname "$0")/.." && pwd)
CHROME=${CHROME:-$(command -v chromium || command -v chromium-browser || command -v chrome-for-testing || true)}
[ -z "$CHROME" ] && { echo "No Chromium found: set CHROME=/path/to/chromium" >&2; exit 1; }
PROFILE=${PROFILE:-$(mktemp -d "${TMPDIR:-/tmp}/jev-voice-profile.XXXXXX")}
"$ROOT/bin/install" --profile "$PROFILE" >/dev/null
ID=$(python3 -c "
import base64, hashlib, json, sys
key = json.load(open(sys.argv[1]))['key']
print(''.join(chr(97 + int(c, 16)) for c in hashlib.sha256(base64.b64decode(key)).hexdigest()[:32]))
" "$ROOT/extension/manifest.json")
echo "profile: $PROFILE"
echo "panel:   chrome-extension://$ID/panel.html (it drives the last tab you used)"
exec "$CHROME" --user-data-dir="$PROFILE" --no-first-run --no-default-browser-check \
  --load-extension="$ROOT/extension" "$@" https://books.toscrape.com/ "chrome-extension://$ID/panel.html"
